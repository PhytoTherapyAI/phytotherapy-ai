# DoctoPal Mobile — Sprint 30 Commit 1
# Copy this file to .env and fill in real values.
# Web parity: same Supabase project, separate env keys (EXPO_PUBLIC_ prefix
# is required so values are bundled into the client at build time — Expo's
# convention, mirrors Next.js NEXT_PUBLIC_ pattern).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
